{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight collaborative document editor (Ajaia take-home)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,cyan \"node --watch server/index.js\" \"vite\"",
