    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
